# Base style: LLVM (a good fit for the existing brace/indent conventions).
BasedOnStyle: LLVM

# Indentation
IndentWidth: 2       # 2 spaces
TabWidth: 2
UseTab: Never   # No tabs
ContinuationIndentWidth: 2
AlignAfterOpenBracket: DontAlign

# Line breaking and alignment
ColumnLimit: 100     # Wrap lines longer than this.
#AlignAfterOpenBracket: Align   # Align a multi-line function signature to the opening paren.
BinPackParameters: false     # Put each parameter on its own line when a signature overflows.
BinPackArguments: false
AllowShortFunctionsOnASingleLine: Empty    # Empty function bodies can stay on one line, e.g. `{}`.
AllowShortBlocksOnASingleLine: true
AllowShortIfStatementsOnASingleLine: true
AllowShortLoopsOnASingleLine: true
AllowShortCaseLabelsOnASingleLine: true
# Pointer alignment: asterisk stays next to the variable name (e.g. `auto *identifier`).
PointerAlignment: Right

# Brace style: Attach (LLVM default).
# Everything else left blank to use LLVM defaults.

